<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="GameReferences.props" Condition="Exists('GameReferences.props')" />

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>KeyErrorFinn.QuickSell</RootNamespace>
    <AssemblyName>KeyErrorFinn.QuickSell</AssemblyName>
    <Product>How to QuickSell</Product>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DeployToProfile>false</DeployToProfile>
    <DeployToScriptEngine>true</DeployToScriptEngine>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BepInExDir)\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExDir)\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(HowToFishGameDir)\How to Fish_Data\Managed\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="FishNet.Runtime"><HintPath>$(HowToFishGameDir)\How to Fish_Data\Managed\FishNet.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(HowToFishGameDir)\How to Fish_Data\Managed\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(HowToFishGameDir)\How to Fish_Data\Managed\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(HowToFishGameDir)\How to Fish_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(HowToFishGameDir)\How to Fish_Data\Managed\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(HowToFishGameDir)\How to Fish_Data\Managed\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(HowToFishGameDir)\How to Fish_Data\Managed\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <PropertyGroup>
    <ModDeployDirectory Condition="'$(DeployToScriptEngine)' == 'true'">$(BepInExDir)\scripts</ModDeployDirectory>
    <ModDeployDirectory Condition="'$(DeployToScriptEngine)' != 'true'">$(BepInExDir)\plugins\KeyErrorFinn-QuickSell</ModDeployDirectory>
  </PropertyGroup>

  <Target Name="CopyToThunderstoreProfile" AfterTargets="Build" Condition="'$(DeployToProfile)' == 'true' and Exists('$(BepInExDir)')">
    <MakeDir Directories="$(ModDeployDirectory)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModDeployDirectory)" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ModDeployDirectory)" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
  </Target>
</Project>
